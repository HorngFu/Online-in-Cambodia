# Keystatic GitHub mode (online editing). See docs/EDITOR_GUIDE.md.
#
# Locally, Keystatic's setup page writes the real values to .env for you.
# Never commit .env. In production these live in Cloudflare:
#   - NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG: build variable (Settings → Build)
#   - the other three: runtime secrets (Settings → Variables and Secrets)

# Turns on GitHub mode once the app exists. Public; inlined at build time.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Secrets: runtime only.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Only for the one-time GitHub App setup, before the slug exists:
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
